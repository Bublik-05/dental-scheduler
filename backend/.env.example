# Copy to .env and fill in values
SECRET_KEY=your-secret-key-here-generate-a-real-one
DJANGO_SETTINGS_MODULE=core.settings.local

# Local DB
DB_NAME=dental_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Production only (set on Railway)
